PORT=8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mcp_platform
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=change-me

# JWT authentication. Replace this value with a long random secret outside development.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_TTL=24h

# Redis-backed request rate limiting.
REDIS_ADDR=localhost:6379

# Public gateway address used when generating MCP client configuration.
PUBLIC_BASE_URL=http://localhost:8080

# ClickHouse HTTP protocol connection used by A13 analytical audit storage.
CLICKHOUSE_ADDR=localhost:8123
CLICKHOUSE_DATABASE=mcp_nexus
CLICKHOUSE_USER=mcp_nexus
CLICKHOUSE_PASSWORD=change-me
